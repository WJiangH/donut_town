# Copy this file to .env.local. Do not commit real credentials.
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C0123456789
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret

# Must exactly match the Slack OAuth redirect URL when explicitly set.
PUBLIC_BASE_URL=https://donut-town.onrender.com

# Required on Render for direct staging access. Slack entry links bypass this prompt.
STAGING_PASSWORD=choose-a-long-random-password


# Keep false until a single-user DM preview has been reviewed.
SLACK_ALLOW_SEND=false
PORT=4173
