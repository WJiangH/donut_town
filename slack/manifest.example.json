{
  "display_information": { "name": "Donut Town", "description": "A little pixel world for your Slack team." },
  "features": { "bot_user": { "display_name": "Donut Bot", "always_online": false } },
  "oauth_config": {
    "redirect_urls": [],
    "scopes": {
